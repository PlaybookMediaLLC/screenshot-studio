wait_for_http() {
  local url="$1"
  local label="$2"
  local attempt

  for attempt in $(seq 1 30); do
    if curl --fail --silent --show-error "$url" >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done

  echo "$label did not become ready: $url" >&2
  exit 1
}

wait_for_screenshot_mock() {
  local attempt

  for attempt in $(seq 1 30); do
    if compose exec -T app node -e 'fetch("http://screenshot-mock:5678/?url=https://readiness.example/probe").then((response) => process.exit(response.ok ? 0 : 1), () => process.exit(1))' >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done

  echo "The app container cannot reach screenshot-mock:5678." >&2
  compose --profile e2e ps --all >&2 || true
  compose --profile e2e logs screenshot-mock >&2 || true
  exit 1
}

smoke() {
  local storage_test_url

  load_env
  storage_test_url="http://127.0.0.1:9003/$R2_BUCKET_NAME/smoke/health/smoke.txt"
  compose exec -T postgres pg_isready --username=postgres --dbname=postgres >/dev/null
  compose exec -T redis redis-cli ping | grep -qx PONG
  wait_for_http "http://127.0.0.1:9003/health/live" "RustFS"
  wait_for_http "http://127.0.0.1:8080/readyz" "Go backend"
  curl --fail --silent --show-error --request PUT "$storage_test_url" \
    --aws-sigv4 "aws:amz:us-east-1:s3" --user "$RUSTFS_ACCESS_KEY:$RUSTFS_SECRET_KEY" \
    --data "smoke" >/dev/null
  curl --fail --silent --show-error "$storage_test_url" \
    --aws-sigv4 "aws:amz:us-east-1:s3" --user "$RUSTFS_ACCESS_KEY:$RUSTFS_SECRET_KEY" | grep -qx smoke
  curl --fail --silent --show-error --request DELETE "$storage_test_url" \
    --aws-sigv4 "aws:amz:us-east-1:s3" --user "$RUSTFS_ACCESS_KEY:$RUSTFS_SECRET_KEY" >/dev/null
  wait_for_http "http://127.0.0.1:3000/api/health" "Screenshot Studio"
  wait_for_http "http://127.0.0.1:3000/api/auth/ok" "Better Auth"
  # A cold editor compile can outlast the locale proxy's request
  # deadline. Finish it before the one-shot public endpoint smoke checks.
  wait_for_redirect_or_ok "http://127.0.0.1:3000/" "Screenshot Studio editor route"
  [[ "$(curl --silent --output /dev/null --write-out '%{http_code}' --request POST \
    --header 'content-type: application/json' --data '{}' \
    http://127.0.0.1:3000/api/screenshot/invalidate)" == "401" ]]
  [[ "$(curl --silent --output /dev/null --write-out '%{http_code}' --request POST \
    --header "x-shots-maintenance-secret: $CLEANUP_SECRET" \
    --header 'content-type: application/json' --data '{"url":"not-a-url"}' \
    http://127.0.0.1:3000/api/screenshot/invalidate)" == "400" ]]
  rate_limit_smoke
  echo "Local stack is healthy."
}

rate_limit_smoke() {
  node "$WEB_DIR/scripts/smoke-rate-limit.mjs"
}

tenant_isolation() {
  load_env
  wait_for_http "http://localhost:3000/api/health" "Screenshot Studio"
  TENANT_TEST_BASE_URL="http://localhost:3000" npm --prefix "$WEB_DIR" run test:tenant-isolation
}

wait_for_redirect_or_ok() {
  local url="$1"
  local label="$2"
  local attempt
  local status

  # Warms a route that answers signed-out traffic with a redirect. Any HTTP
  # response proves the route compiled, which is all warming needs. This is
  # explicit rather than reusing wait_for_http because `curl --fail` treats a
  # 3xx as success only while nothing follows the redirect; the moment a
  # caller adds --location, the redirect target's status decides instead and
  # the warm-up silently starts depending on auth state. Asserting 2xx-or-3xx
  # here keeps that intent local and durable.
  for attempt in $(seq 1 60); do
    status="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 120 "$url" || true)"
    if [[ "$status" =~ ^[23] ]]; then
      return
    fi
    sleep 1
  done

  echo "$label did not become ready: $url (last status ${status:-none})" >&2
  exit 1
}

warm_route() {
  local url="$1"
  local label="$2"
  local attempt
  local status

  # Like wait_for_redirect_or_ok, for API routes: signed out they answer 401,
  # which proves the route compiled just as well. A 5xx does not.
  for attempt in $(seq 1 60); do
    status="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 120 "$url" || true)"
    if [[ "$status" =~ ^[234] ]]; then
      return
    fi
    sleep 1
  done

  echo "$label did not become ready: $url (last status ${status:-none})" >&2
  exit 1
}

warm_recovery_route() {
  local url="$1"
  local manage_app="$2"
  local attempt
  local status

  for attempt in $(seq 1 10); do
    status="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 30 --request POST "$url" || true)"
    if [[ "$status" == "401" ]]; then
      return
    fi
    # Turbopack can miss nested routes until a file event refreshes its router.
    # Only refresh our managed dev server; a generic 404 is never a ready API.
    if [[ "$status" == "404" && "$manage_app" == "true" ]]; then
      touch "$WEB_DIR/app/api/v1/content-drafts/[id]/revisions/[revisionId]/recover/route.ts"
    fi
    sleep 1
  done

  echo "Draft recovery API did not become ready: $url (last status ${status:-none})" >&2
  exit 1
}

# Starts the e2e services with the app of one lane: `production` runs the
# production build (dev/compose.e2e.yaml), `dev-server` runs `next dev`.
start_e2e_app() {
  local lane="$1" app_url="$2" trusted_origins="$3"
  local lane_files=()
  if [[ "$lane" == production ]]; then
    lane_files=(--file "$ROOT_DIR/dev/compose.e2e.yaml")
  fi
  # Recreating app would strand the renderer, which shares app's network;
  # end-to-end flows do not render designs, so it is simply stopped.
  compose --profile renderer stop render-browser >/dev/null 2>&1 || true
  compose stop app >/dev/null 2>&1 || true
  if [[ "$lane" == production ]]; then
    # CI builds the image once, with a layer cache, and sets E2E_APP_IMAGE_READY.
    if [[ "${E2E_APP_IMAGE_READY:-}" != "true" ]]; then
      compose "${lane_files[@]}" build app
    fi
  else
    # Start the dev server from an empty dev cache. On Linux, a Turbopack
    # cache written by the previous server (verify:agents, tenant-isolation)
    # made the recreated one answer every HMR connection with "HMR hash
    # mismatch", reloading each page in a loop so sign-up never hydrated.
    compose run --rm --no-deps app sh -c 'rm -rf apps/web/.next/* apps/web/.next/.[!.]*'
  fi
  # Plain node does not reload bind-mounted mock code between local runs.
  compose --profile e2e up --detach --force-recreate screenshot-mock
  BETTER_AUTH_URL="${app_url%/}" \
    BETTER_AUTH_TRUSTED_ORIGINS="$trusted_origins" \
    NEXT_PUBLIC_APP_URL="${app_url%/}" \
    SOCIAL_API_URL="${E2E_SOCIAL_API_URL:-http://host.docker.internal:5679/api/public/v1}" \
    PLATFORM_SOCIAL_BLUESKY_ENABLED=true \
    PLATFORM_SOCIAL_CUSTOM_MASTODON_ENABLED=true \
    SCREENSHOT_API_URL="http://screenshot-mock:5678" \
    SCREENSHOT_E2E_ALLOWED_DOWNLOAD_HOSTS="screenshot-mock" \
    OPENROUTER_API_KEY="e2e-openrouter" \
    OPENROUTER_BASE_URL="http://screenshot-mock:5678/openrouter/api/v1" \
    PLATFORM_ENRICHMENT_DISABLED="github,appstore" \
    PLATFORM_ENRICHMENT_EXA_API_KEY="" \
    PLATFORM_CREATIVE_SETS="enabled" \
    PLATFORM_AI_SCRIPTED=1 compose ${lane_files[@]+"${lane_files[@]}"} --profile e2e up --detach screenshot-mock publishing-backend publishing-orchestrator app
  wait_for_screenshot_mock
  # Publishing runs in the backend, so it is the service that must reach the
  # suite's social API mock.
  wait_for_http "http://127.0.0.1:8080/readyz" "Publishing backend"
}

# `next dev` compiles each route on its first request.
warm_e2e_routes() {
  local app_url="$1" manage_screenshot_mock="$2"
  # Every spec signs up first; a cold Better Auth route compiles during that
  # first POST and the dev server reloads the page under it, emptying the form.
  wait_for_http "${app_url%/}/api/auth/ok" "Better Auth"
  wait_for_http "${app_url%/}/sign-up" "Screenshot Studio sign-up route"
  # The stack runs `next dev`, so a route is compiled on its first request.
  # A browser navigation to an uncompiled route keeps `page.url()` on the
  # previous page until the server responds, so an unwarmed route looks to
  # Playwright exactly like a redirect that never happened. Warm every route
  # the suite navigates to, not just the entry points: /two-factor,
  # /onboarding and /workspace are reached mid-test, so they were paying a
  # cold compile inside a timed assertion. Measured cold on a developer
  # machine: /two-factor 10s, /workspace 15s, /onboarding 31s.
  # A 307 is a warm hit too, the redirect still compiles the route.
  wait_for_redirect_or_ok "${app_url%/}/sign-in" "Screenshot Studio sign-in route"
  # Every spec starts at sign-up, and a cold compile there reloads the page
  # mid-typing; the campaign pages stalled the same way.
  wait_for_redirect_or_ok "${app_url%/}/sign-up" "Screenshot Studio sign-up route"
  wait_for_redirect_or_ok "${app_url%/}/campaigns" "Screenshot Studio campaigns route"
  wait_for_redirect_or_ok "${app_url%/}/campaigns/new" "Screenshot Studio new campaign route"
  # A campaign's pages redirect signed-out traffic after compiling, so any id warms them.
  for campaign_page in "" /spec /plan /assets /copy; do
    wait_for_redirect_or_ok "${app_url%/}/campaigns/warm-up${campaign_page}" "Screenshot Studio campaign${campaign_page:- overview} route"
  done
  wait_for_redirect_or_ok "${app_url%/}/assets" "Screenshot Studio assets route"
  wait_for_redirect_or_ok "${app_url%/}/drafts" "Screenshot Studio drafts route"
  wait_for_redirect_or_ok "${app_url%/}/drafts/warm-up" "Screenshot Studio draft composer route"
  # Legacy /drafts only compiles its redirect, not the current writing routes.
  wait_for_redirect_or_ok "${app_url%/}/write" "Screenshot Studio writing library route"
  wait_for_redirect_or_ok "${app_url%/}/write/warm-up" "Screenshot Studio writing composer route"
  wait_for_redirect_or_ok "${app_url%/}/two-factor" "Screenshot Studio two-factor route"
  wait_for_redirect_or_ok "${app_url%/}/onboarding" "Screenshot Studio onboarding route"
  wait_for_redirect_or_ok "${app_url%/}/workspace" "Screenshot Studio workspace route"
  wait_for_redirect_or_ok "${app_url%/}/accept-invitation" "Screenshot Studio invitation route"
  # API routes the suite calls mid-test; a cold compile there ran tests out of time.
  warm_route "${app_url%/}/api/tenant/releases" "Tenant releases API"
  warm_route "${app_url%/}/api/tenant/assets/upload-url" "Tenant assets API"
  warm_route "${app_url%/}/api/v1/bootstrap" "Shell bootstrap API"
  warm_route "${app_url%/}/api/v1/content-drafts" "Content drafts API"
  warm_route "${app_url%/}/api/v1/organizations/warm-up" "Shell organizations API"
  warm_recovery_route "${app_url%/}/api/v1/content-drafts/warm-up/revisions/warm-up/recover" "$manage_screenshot_mock"
  wait_for_http "$app_url" "Screenshot Studio editor route"
}

# Runs npm in the web app with the variables the browser suite reads.
e2e_npm() {
  local app_url="$1"
  shift
  E2E_BASE_URL="$app_url" \
    E2E_DATABASE_URL="${E2E_DATABASE_URL:-$HOST_DATABASE_URL}" \
    E2E_COMPOSE_LOGS="$manage_screenshot_mock" \
    E2E_MAINTENANCE_SECRET="$CLEANUP_SECRET" \
    E2E_R2_ACCESS_KEY_ID="${E2E_R2_ACCESS_KEY_ID:-$R2_ACCESS_KEY_ID}" \
    E2E_R2_BUCKET_NAME="${E2E_R2_BUCKET_NAME:-$R2_BUCKET_NAME}" \
    E2E_R2_ENDPOINT="${E2E_R2_ENDPOINT:-http://127.0.0.1:9003}" \
    E2E_R2_REGION="${E2E_R2_REGION:-$R2_REGION}" \
    E2E_R2_SECRET_ACCESS_KEY="${E2E_R2_SECRET_ACCESS_KEY:-$R2_SECRET_ACCESS_KEY}" \
    E2E_REDIS_URL="${E2E_REDIS_URL:-redis://127.0.0.1:63799}" \
    E2E_WEBHOOK_SECRET="$CLEANUP_SECRET" \
    E2E_WORKFLOW_RENDER_KEY="${PLATFORM_WORKFLOW_RENDER_KEY:-}" \
    npm --prefix "$WEB_DIR" "$@"
}

run_e2e() {
  local test_script="$1"
  shift
  local app_url="${E2E_BASE_URL:-http://localhost:3000}"
  local e2e_trusted_origins
  local manage_screenshot_mock="${E2E_MANAGE_SCREENSHOT_MOCK:-true}"
  local test_result=0
  local lane listing ran_lane=false

  load_env
  if [[ "$manage_screenshot_mock" == "true" ]]; then
    sync_dependencies
  fi
  e2e_trusted_origins="$BETTER_AUTH_TRUSTED_ORIGINS,${app_url%/},http://localhost:5680,http://host.docker.internal:5680"
  if [[ "$manage_screenshot_mock" != "true" ]]; then
    # A deployed stack (Kind) runs the production build: only that lane applies.
    wait_for_http "${app_url%/}/api/health" "Screenshot Studio"
    E2E_LANE=production e2e_npm "$app_url" run "$test_script" -- --project=production "$@" || test_result=1
    return "$test_result"
  fi
  # Two lanes, as Next.js recommends: the production build for every test it
  # can serve, then `next dev` for the tests tagged @dev-server, which need
  # its hooks (the scripted AI model, screenshot-mock downloads).
  for lane in production dev-server; do
    if ! listing="$(e2e_npm "$app_url" run --silent "$test_script" -- "$@" --list --pass-with-no-tests --project="$lane" --reporter=list 2>&1)"; then
      echo "$listing" >&2
      return 1
    fi
    grep -qE 'Total: [1-9]' <<<"$listing" || continue
    ran_lane=true
    start_e2e_app "$lane" "$app_url" "$e2e_trusted_origins"
    wait_for_http "${app_url%/}/api/health" "Screenshot Studio"
    if [[ "$lane" == dev-server ]]; then
      warm_e2e_routes "$app_url" "$manage_screenshot_mock"
    fi
    E2E_LANE="$lane" e2e_npm "$app_url" run "$test_script" -- --project="$lane" "$@" || test_result=1
    # Recreating app discards the logs of the server that ran the lane; keep
    # them beside the Playwright results, which CI uploads on failure.
    mkdir -p "$WEB_DIR/test-results"
    compose logs --no-color app >"$WEB_DIR/test-results/app-$lane.log" 2>&1 || true
  done
  if [[ "$ran_lane" != true ]]; then
    echo "No end-to-end tests match: $*" >&2
    return 1
  fi
  SCREENSHOT_API_URL="" SCREENSHOT_E2E_ALLOWED_DOWNLOAD_HOSTS="" OPENROUTER_BASE_URL="" \
    compose up --detach --force-recreate publishing-backend publishing-orchestrator app
  return "$test_result"
}

e2e() {
  run_e2e test:e2e "$@"
}

e2e_onboarding() {
  run_e2e test:e2e:onboarding
}

e2e_recovery() {
  run_e2e test:e2e:recovery
}

e2e_file() {
  if [[ "$#" -eq 0 ]]; then
    echo "Provide one Playwright test path." >&2
    exit 2
  fi
  run_e2e test:e2e "$@"
}

check() {
  ensure_env
  sync_dependencies
  # quality:check minus verify:rfcs, which shells out to git and python3.
  # Those run on the host: inside the container a worktree's .git points at
  # a host path that does not exist.
  compose run --rm --no-deps app sh -c \
    'npm run format:check && npm run lint -- --max-warnings=0 && npm run typecheck && npm run test'
  (cd "$ROOT_DIR" && python3 dev/verify-rfcs.py)
}

# A local account with a workspace, so a fresh database never leaves you at a
# sign-in page with nothing to sign in with. Safe to run repeatedly.
dev_login() {
  local app="http://localhost:3000"
  local email="dev@localhost.test"
  local jar
  local password

  ensure_env_value STUDIO_DEV_PASSWORD "dev-$(random_hex 12)"
  password="$(grep '^STUDIO_DEV_PASSWORD=' "$LOCAL_ENV" | cut -d= -f2-)"
  jar="$(mktemp)"
  # Fails harmlessly when the account already exists.
  curl --silent --output /dev/null --header "content-type: application/json" --header "origin: $app" \
    --data "{\"name\":\"Dev\",\"email\":\"$email\",\"password\":\"$password\"}" "$app/api/auth/sign-up/email" || true
  if ! curl --fail --silent --output /dev/null --cookie-jar "$jar" --header "content-type: application/json" \
    --header "origin: $app" --data "{\"email\":\"$email\",\"password\":\"$password\"}" "$app/api/auth/sign-in/email"; then
    echo "Dev login: could not sign in as $email; sign up at $app/sign-up instead." >&2
    rm -f "$jar"
    return 0
  fi
  if ! curl --silent --cookie "$jar" "$app/api/trpc/workspace.listMine" | grep -q '"slug"'; then
    curl --fail --silent --output /dev/null --cookie "$jar" --header "content-type: application/json" \
      --header "origin: $app" --data '{"json":{"name":"Playbook Dev","slug":"playbook-dev"}}' \
      "$app/api/trpc/workspace.create" || echo "Dev login: could not create its workspace." >&2
  fi
  rm -f "$jar"
  # There is no free plan, so the local workspace gets Pro to stay usable.
  # Production entitlements come only from Stripe.
  compose exec -T postgres psql --quiet --username=postgres --dbname=screenshot_studio --command \
    "INSERT INTO workspace_entitlement (\"organizationId\", plan, status, \"createdAt\", \"updatedAt\")
     SELECT id, 'pro', 'active', now(), now() FROM organization WHERE slug = 'playbook-dev'
     ON CONFLICT (\"organizationId\") DO NOTHING" >/dev/null ||
    echo "Dev login: could not give Playbook Dev a plan." >&2
  echo "Dev login: $email (password: STUDIO_DEV_PASSWORD in .local/dev.env)"
}

up() {
  ensure_env
  compose rm --force --stop rustfs-init >/dev/null 2>&1 || true
  compose up --detach --build postgres redis rustfs rustfs-init publishing-backend publishing-orchestrator collab
  sync_dependencies
  # The render browser runs locally by default for parity with production,
  # where designs render in Cloudflare Browser Rendering over the same CDP
  # path. CI skips it (its flows do not render designs); STUDIO_RENDERER=off
  # skips it locally. Without it, the app falls back to sharp product shots.
  local renderer="on"
  if [[ "${CI:-}" == "true" || "${STUDIO_RENDERER:-on}" == "off" ]]; then
    renderer="off"
  fi
  if [[ "$renderer" == "on" ]]; then
    # One call: the browser depends on app, so a separate `up render-browser`
    # without the variable would recreate app with the renderer disabled.
    PLATFORM_DESIGN_RENDERER=enabled compose --profile renderer up --detach app render-browser
  else
    compose up --detach app
  fi
  smoke
  dev_login
  echo "App:     http://localhost:3000"
  if [[ "$renderer" == "on" ]]; then
    echo "Render browser: running (STUDIO_RENDERER=off to skip)"
  fi
  echo "Backend: http://localhost:8080 (Temporal UI: http://localhost:8233)"
  echo "RustFS:  http://localhost:9004/rustfs/console/"
}

down() {
  local mode=""
  local response=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep-data) mode="keep" ;;
      --purge) mode="purge" ;;
      --yes) mode="${mode:-keep}" ;;
      *) echo "Unknown down option: $1" >&2; exit 2 ;;
    esac
    shift
  done

  ensure_env
  if [[ -z "$mode" ]]; then
    read -r -p "Preserve Postgres, Redis, and RustFS data? [Y/n] " response
    if [[ "$response" =~ ^[Nn]$ ]]; then
      mode="purge"
    else
      mode="keep"
    fi
  fi

  if [[ "$mode" == "purge" ]]; then
    compose --profile e2e --profile renderer down --volumes --remove-orphans
    return
  fi

  compose --profile e2e --profile renderer down --remove-orphans
}

kind_up() {
  ensure_env
  write_kind_env

  if ! kind get clusters | grep -qx "$KIND_CLUSTER"; then
    kind create cluster --name "$KIND_CLUSTER" --wait 60s
  fi

  docker build --file "$WEB_DIR/Dockerfile" --tag screenshot-studio:kind-dev "$ROOT_DIR"
  docker build --tag screenshot-studio-backend:kind-dev "$ROOT_DIR/server"
  kind load docker-image screenshot-studio:kind-dev --name "$KIND_CLUSTER"
  docker build --file "$ROOT_DIR/clients/apps/collab-server/Dockerfile" \
    --tag screenshot-studio-collab:kind-dev "$ROOT_DIR"
  kind load docker-image screenshot-studio-backend:kind-dev --name "$KIND_CLUSTER"
  kind load docker-image screenshot-studio-collab:kind-dev --name "$KIND_CLUSTER"
  kubectl create namespace "$KIND_NAMESPACE" --dry-run=client --output=yaml | kubectl apply --filename -
  kubectl create secret generic screenshot-studio-local \
    --namespace "$KIND_NAMESPACE" \
    --from-env-file="$KIND_ENV" \
    --dry-run=client \
    --output=yaml | kubectl apply --filename -
  helm upgrade --install screenshot-studio "$ROOT_DIR/infra/charts/screenshot-studio" \
    --namespace "$KIND_NAMESPACE" \
    --values "$ROOT_DIR/infra/charts/screenshot-studio/values-kind.yaml" \
    --set image.repository=screenshot-studio \
    --set image.tag=kind-dev \
    --set image.pullPolicy=Never \
    --set existingSecret=screenshot-studio-local \
    --wait \
    --wait-for-jobs \
    --timeout 8m
  kubectl rollout restart deployment/screenshot-studio deployment/screenshot-studio-backend --namespace "$KIND_NAMESPACE"
  kubectl rollout status deployment/screenshot-studio --namespace "$KIND_NAMESPACE" --timeout=3m
  kubectl rollout status deployment/screenshot-studio-backend --namespace "$KIND_NAMESPACE" --timeout=3m
}

kind_down() {
  local auto_confirm="false"
  local response=""

  if [[ "${1:-}" == "--yes" ]]; then
    auto_confirm="true"
  elif [[ -n "${1:-}" ]]; then
    echo "Unknown kind-down option: $1" >&2
    exit 2
  fi

  if [[ "$auto_confirm" != "true" ]]; then
    read -r -p "Delete the Kind cluster and all local cluster data? [y/N] " response
  fi
  if [[ "$auto_confirm" != "true" && ! "$response" =~ ^[Yy]$ ]]; then
    echo "Kind cluster preserved."
    return
  fi

  kind delete cluster --name "$KIND_CLUSTER"
}

usage() {
  cat <<EOF
Usage: dev/studio <command>

Commands:
  env                        Create or refresh the ignored local environment.
  up                         Start the hot-reload Compose stack.
  down [--keep-data|--purge] Stop the Compose stack and prompt for data handling.
  reset                      Stop the Compose stack and remove all local data.
  smoke                      Verify Compose service health.
  rate-limit-smoke           Verify Redis-backed screenshot API rate limiting.
  tenant-isolation           Verify two-organization session and API-key isolation.
  e2e                        Run all browser end-to-end flows.
  e2e-file <path>            Run one browser end-to-end flow.
  e2e-onboarding             Verify browser sign-up and workspace onboarding.
  e2e-recovery               Verify dependency failure and recovery behavior.
  check                      Run the server-boundary quality checks in Docker.
  logs [service]             Follow local service logs.
  status                     Show local Compose services.
  kind-up                    Build, load, and install the Kind development stack.
  kind-down                  Delete the Kind development cluster after confirmation.
EOF
}

case "${1:-}" in
  env) ensure_env ;;
  up) up ;;
  down) shift; down "$@" ;;
  reset) down --purge --yes ;;
  smoke) smoke ;;
  rate-limit-smoke) rate_limit_smoke ;;
  tenant-isolation) tenant_isolation ;;
  e2e) shift; e2e "$@" ;;
  e2e-file) shift; e2e_file "$@" ;;
  e2e-onboarding) e2e_onboarding ;;
  e2e-recovery) e2e_recovery ;;
  check) check ;;
  logs) ensure_env; shift; compose logs --follow "${@:-}" ;;
  status) ensure_env; compose ps ;;
  kind-up) kind_up ;;
  kind-down) shift; kind_down "$@" ;;
  ""|help|--help|-h) usage ;;
  *) echo "Unknown command: $1" >&2; usage; exit 2 ;;
esac
