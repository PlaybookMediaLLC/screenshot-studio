#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ ! -f .local/dev.env ]]; then
  echo 'Start the local web stack with ./bin/studio up first.' >&2
  exit 1
fi

mkdir -p .context
BOOTSTRAP_FILE="$(mktemp "$ROOT_DIR/.context/social-gate-XXXXXX.json")"
chmod 600 "$BOOTSTRAP_FILE"
WEB_RECONFIGURED=false

gate_compose() {
  docker compose --env-file .local/dev.env --file compose.social-gate.yaml \
    --project-name screenshot-studio-social-gate "$@"
}

cleanup() {
  local original_status=$?
  trap - EXIT
  if [[ "$WEB_RECONFIGURED" == true ]]; then
    node e2e/fixtures/configure-web.mjs restore || original_status=1
  fi
  gate_compose down --volumes --remove-orphans || original_status=1
  rm -f "$BOOTSTRAP_FILE"
  exit "$original_status"
}
trap cleanup EXIT

if [[ "${SOCIAL_GATE_NO_BUILD:-}" == true ]]; then
  gate_compose up --detach --no-build --wait
else
  gate_compose up --detach --build --wait
fi
node e2e/fixtures/bootstrap-go.mjs "$BOOTSTRAP_FILE"
WEB_RECONFIGURED=true
node e2e/fixtures/configure-web.mjs gate "$BOOTSTRAP_FILE"
for attempt in $(seq 1 60); do
  if curl --fail --silent --output /dev/null http://127.0.0.1:3000/api/health; then
    break
  fi
  if [[ "$attempt" == 60 ]]; then
    echo 'The web app did not become healthy after test configuration.' >&2
    exit 1
  fi
  sleep 1
done

set -a
# shellcheck source=/dev/null
source .local/dev.env
set +a
E2E_DATABASE_URL="$HOST_DATABASE_URL" \
E2E_MAINTENANCE_SECRET="$CLEANUP_SECRET" \
E2E_R2_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" \
E2E_R2_BUCKET_NAME="$R2_BUCKET_NAME" \
E2E_R2_ENDPOINT=http://127.0.0.1:9003 \
E2E_R2_REGION="$R2_REGION" \
E2E_R2_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY" \
E2E_REDIS_URL=redis://127.0.0.1:63799 \
E2E_WEBHOOK_SECRET="$CLEANUP_SECRET" \
E2E_SOCIAL_GATE_BOOTSTRAP="$BOOTSTRAP_FILE" \
  npx playwright test e2e/postiz-scheduling.spec.ts --grep 'real Go worker' --retries=0
