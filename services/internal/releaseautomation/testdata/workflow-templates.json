      {
        "id": "campaign",
        "type": "action",
        "action": {
          "type": "create_campaign",
          "input": {
            "nodeId": "release",
            "output": "releaseId"
          },
          "brandKitId": "brand-fixture",
          "destinationIds": [
            "destination-fixture"
          ]
        }
      },
      {
        "id": "review",
        "type": "action",
        "action": {
          "type": "submit_review",
          "input": {
            "nodeId": "campaign",
            "output": "campaignId"
          }
        }
      },
      {
        "id": "done",
        "type": "end",
        "outcome": "completed"
      },
      {
        "id": "skip",
        "type": "end",
        "outcome": "skipped"
      }
    ],
    "edges": [
      {
        "from": "trigger",
        "to": "condition",
        "branch": "next"
      },
      {
        "from": "condition",
        "to": "release",
        "branch": "true"
      },
      {
        "from": "condition",
