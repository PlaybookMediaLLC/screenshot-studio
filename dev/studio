#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WEB_DIR="$ROOT_DIR/clients/apps/web"
LOCAL_DIR="$ROOT_DIR/.local"
LOCAL_ENV="$LOCAL_DIR/dev.env"
KIND_ENV="$LOCAL_DIR/kind.env"
KIND_CLUSTER="screenshot-studio-dev"
KIND_NAMESPACE="screenshot-studio"

compose() {
  local compose_args=(--env-file "$LOCAL_ENV" --file "$ROOT_DIR/dev/compose.yaml")
  # Optional social provider credentials for the product API's channel connections.
  if [[ -f "$LOCAL_DIR/social.env" ]]; then
    compose_args+=(--env-file "$LOCAL_DIR/social.env")
  fi
  if [[ "${E2E_DOCKER_HOST_GATEWAY:-}" == "true" ]]; then
    compose_args+=(--file "$ROOT_DIR/dev/compose.ci.yaml")
  fi
  docker compose "${compose_args[@]}" "$@"
}

random_hex() {
  openssl rand -hex "$1"
}

random_base64() {
  openssl rand -base64 "$1" | tr -d '\n'
}

ensure_env_value() {
  local key="$1"
  local value="$2"

  if ! grep -q "^${key}=" "$LOCAL_ENV"; then
    printf '%s=%s\n' "$key" "$value" >>"$LOCAL_ENV"
  fi
}

# One social API secret per parallel e2e worker. Its token routes the backend's
# social calls to that worker's mock (test/e2e/framework/social-mock.ts).
ensure_e2e_social_secrets() {
  local slot
  for slot in 0 1 2 3 4 5 6 7; do
    ensure_env_value "SOCIAL_API_KEY_E2E_W$slot" "e2e-social-w$slot"
  done
}

ensure_env() {
  if [[ -f "$LOCAL_ENV" ]]; then
    local database_url
    node - "$LOCAL_ENV" <<'NODE'
const fs = require("node:fs");
const [file] = process.argv.slice(2);
const current = fs.readFileSync(file, "utf8");
const next = current
  .replace(/^MINIO_ROOT_USER=/m, "RUSTFS_ACCESS_KEY=")
  .replace(/^MINIO_ROOT_PASSWORD=/m, "RUSTFS_SECRET_KEY=")
  .replace(/^R2_ENDPOINT=http:\/\/minio:9000$/m, "R2_ENDPOINT=http://rustfs:9000");
    if (next !== current) fs.writeFileSync(file, next);
NODE
    ensure_env_value CLEANUP_SECRET "$(random_hex 32)"
    ensure_env_value BETTER_AUTH_SECRET "$(random_hex 32)"
    ensure_env_value AUDIT_IP_HASH_SECRET "$(random_hex 32)"
    ensure_env_value SOURCE_WEBHOOK_SIGNING_KEY "$(random_hex 32)"
    ensure_env_value AUDIT_DRAIN_ENCRYPTION_KEY "$(random_base64 32)"
    ensure_env_value STORE_PUBLISHING_ENCRYPTION_KEY "$(random_base64 32)"
    ensure_env_value PLATFORM_WEBHOOK_ENCRYPTION_KEY "$(random_base64 32)"
    ensure_env_value BETTER_AUTH_URL "http://localhost:3000"
    ensure_env_value NEXT_PUBLIC_APP_URL "http://localhost:3000"
    ensure_env_value BETTER_AUTH_TRUSTED_ORIGINS "http://localhost:3000"
    ensure_env_value SOCIAL_API_URL "http://host.docker.internal:5679/api/public/v1"
    ensure_env_value SOCIAL_API_KEY "e2e-social-token"
    ensure_env_value SOCIAL_API_KEY_E2E "e2e-social-token"
    ensure_e2e_social_secrets
    ensure_env_value PLATFORM_SOCIAL_ENCRYPTION_KEY "$(random_base64 32)"
    ensure_env_value SOCIAL_JWT_SECRET "$(random_hex 32)"
    ensure_env_value PUBLISHING_SERVICE_TOKEN "$(random_hex 32)"
    ensure_env_value COLLAB_TOKEN_SECRET "$(random_hex 32)"
    ensure_env_value COLLAB_SERVICE_TOKEN "$(random_hex 32)"
    # Signs the worker's calls to the web's internal workflow endpoints.
    ensure_env_value PLATFORM_WORKFLOW_RENDER_KEY "$(random_hex 32)"
    database_url="$(grep '^DATABASE_URL=' "$LOCAL_ENV" | cut -d= -f2-)"
    ensure_env_value AUDIT_RETENTION_DATABASE_URL "$database_url"
    chmod 600 "$LOCAL_ENV"
    return
  fi

  mkdir -p "$LOCAL_DIR"
  local postgres_super_password
  local postgres_app_password
  local rustfs_secret_key
  local cleanup_secret
  local better_auth_secret
  local audit_ip_hash_secret
  local audit_drain_encryption_key
  local store_publishing_encryption_key

  postgres_super_password="$(random_hex 24)"
  postgres_app_password="$(random_hex 24)"
  rustfs_secret_key="$(random_hex 24)"
  cleanup_secret="$(random_hex 32)"
  better_auth_secret="$(random_hex 32)"
  audit_ip_hash_secret="$(random_hex 32)"
  source_webhook_signing_key="$(random_hex 32)"
  audit_drain_encryption_key="$(random_base64 32)"
  store_publishing_encryption_key="$(random_base64 32)"

  umask 077
  cat >"$LOCAL_ENV" <<EOF
POSTGRES_SUPER_PASSWORD=$postgres_super_password
POSTGRES_APP_PASSWORD=$postgres_app_password
RUSTFS_ACCESS_KEY=screenshot-studio
RUSTFS_SECRET_KEY=$rustfs_secret_key
CLEANUP_SECRET=$cleanup_secret
BETTER_AUTH_SECRET=$better_auth_secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUDIT_IP_HASH_SECRET=$audit_ip_hash_secret
SOURCE_WEBHOOK_SIGNING_KEY=$source_webhook_signing_key
AUDIT_DRAIN_ENCRYPTION_KEY=$audit_drain_encryption_key
STORE_PUBLISHING_ENCRYPTION_KEY=$store_publishing_encryption_key
PLATFORM_WEBHOOK_ENCRYPTION_KEY=$(random_base64 32)
DATABASE_URL=postgresql://screenshot_studio:$postgres_app_password@postgres:5432/screenshot_studio?schema=public
AUDIT_RETENTION_DATABASE_URL=postgresql://screenshot_studio:$postgres_app_password@postgres:5432/screenshot_studio?schema=public
HOST_DATABASE_URL=postgresql://screenshot_studio:$postgres_app_password@127.0.0.1:54329/screenshot_studio?schema=public
SOCIAL_API_URL=http://host.docker.internal:5679/api/public/v1
SOCIAL_API_KEY=e2e-social-token
SOCIAL_API_KEY_E2E=e2e-social-token
PLATFORM_SOCIAL_ENCRYPTION_KEY=$(random_base64 32)
SOCIAL_JWT_SECRET=$(random_hex 32)
PUBLISHING_SERVICE_TOKEN=$(random_hex 32)
COLLAB_TOKEN_SECRET=$(random_hex 32)
COLLAB_SERVICE_TOKEN=$(random_hex 32)
PLATFORM_WORKFLOW_RENDER_KEY=$(random_hex 32)
R2_ENDPOINT=http://rustfs:9000
R2_REGION=us-east-1
R2_FORCE_PATH_STYLE=true
R2_ACCESS_KEY_ID=screenshot-studio
R2_SECRET_ACCESS_KEY=$rustfs_secret_key
R2_BUCKET_NAME=tenant-assets
REDIS_URL=redis://redis:6379
EOF
  ensure_e2e_social_secrets
  chmod 600 "$LOCAL_ENV"
  echo "Created $LOCAL_ENV"
}

load_env() {
  ensure_env
  set -a
  # shellcheck source=/dev/null
  source "$LOCAL_ENV"
  set +a
}

sync_dependencies() {
  local lock_hash
  local state_file="$LOCAL_DIR/package-lock.sha"

  lock_hash="$(shasum -a 256 "$ROOT_DIR/clients/package-lock.json" | awk '{print $1}')"
  if [[ -f "$state_file" && "$(cat "$state_file")" == "$lock_hash" ]]; then
    return
  fi

  compose run --rm --no-deps app npm ci
  printf '%s\n' "$lock_hash" >"$state_file"
}

