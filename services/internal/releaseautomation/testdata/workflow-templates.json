{
  "release-launch": {
    "schemaVersion": 1,
    "family": "release.published",
    "qualification": {
      "field": "release.tag",
      "operator": "glob",
      "values": [
        "v*"
      ]
    },
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger"
      },
      {
        "id": "condition",
        "type": "condition",
        "condition": {
          "field": "release.prerelease",
          "operator": "is_false"
        }
      },
      {
        "id": "release",
        "type": "action",
        "action": {
          "type": "create_release"
        }
      },
      {
        "id": "campaign",
        "type": "action",
        "action": {
          "type": "create_campaign",
          "input": {
            "nodeId": "release",
            "output": "releaseId"
          },
          "brandKitId": "brand-fixture",
          "destinationIds": [
            "destination-fixture"
          ]
        }
      },
      {
        "id": "review",
        "type": "action",
        "action": {
          "type": "submit_review",
          "input": {
            "nodeId": "campaign",
            "output": "campaignId"
          }
        }
      },
      {
        "id": "done",
        "type": "end",
        "outcome": "completed"
      },
      {
        "id": "skip",
        "type": "end",
        "outcome": "skipped"
      }
    ],
    "edges": [
      {
        "from": "trigger",
        "to": "condition",
        "branch": "next"
      },
      {
        "from": "condition",
        "to": "release",
        "branch": "true"
      },
      {
        "from": "condition",
        "to": "skip",
        "branch": "false"
      },
      {
        "from": "release",
        "to": "campaign",
        "branch": "next"
      },
      {
        "from": "campaign",
        "to": "review",
        "branch": "next"
      },
      {
        "from": "review",
        "to": "done",
        "branch": "next"
      }
    ]
  },
