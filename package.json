{
  "name": "screenshot-studio",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "npx prisma generate && next dev --webpack",
    "build": "npx prisma generate && next build --webpack",
    "start": "next start",
    "db:push": "npx prisma db push",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:status": "npx prisma migrate status",
    "format": "prettier --write app/api lib/api lib/audit lib/email lib/tenant lib/auth lib/rate-limit.ts lib/redis.ts lib/screenshot-cache.ts lib/screenshot-service.ts lib/storage trigger test e2e .github/workflows commitlint.config.mjs playwright.config.ts",
    "format:check": "prettier --check app/api lib/api lib/audit lib/email lib/tenant lib/auth lib/rate-limit.ts lib/redis.ts lib/screenshot-cache.ts lib/screenshot-service.ts lib/storage trigger test e2e .github/workflows commitlint.config.mjs playwright.config.ts",
    "trigger:dev": "trigger.dev dev --config trigger.config.ts",
    "trigger:deploy": "npx trigger.dev@4.5.11 deploy --config trigger.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "quality:check": "npm run format:check && npm run lint -- --max-warnings=0 && npm run typecheck && npm run test",
    "test": "tsx --test test/*.test.ts tests/*.test.ts",
    "verify:agents": "tsx tests/verify-agent-endpoints.ts",
    "test:e2e": "playwright test",
    "test:e2e:onboarding": "playwright test e2e/onboarding.spec.ts",
    "test:e2e:recovery": "E2E_INCLUDE_RECOVERY=true playwright test e2e/dependency-recovery.spec.ts --workers=1",
    "test:tenant-isolation": "tsx scripts/verify-tenant-isolation.ts",
    "test:trpc-smoke": "tsx scripts/verify-trpc-smoke.ts",
    "commitlint": "commitlint",
    "prepare": "git config core.hooksPath .githooks || true",
    "upload-to-r2": "tsx scripts/upload-to-r2.ts",
    "upload-all-to-r2": "tsx scripts/upload-all-to-r2.ts",
    "upload-pattern": "tsx scripts/upload-pattern-to-r2.ts",
    "upload-demo": "tsx scripts/upload-demo-to-r2.ts",
    "verify:announcements": "tsx --tsconfig tsconfig.verify.json scripts/verify-announcement-authoring.ts",
    "verify:storage": "tsx --tsconfig tsconfig.verify.json scripts/verify-tenant-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@better-auth/api-key": "1.6.28",
    "@better-auth/infra": "^0.3.7",
    "@better-auth/scim": "1.6.28",
    "@better-auth/sso": "1.6.28",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hugeicons/react": "^1.1.5",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@scalar/nextjs-api-reference": "^0.11.16",
    "@shadergradient/react": "^2.4.20",
    "@sparticuz/chromium": "^141.0.0",
    "@tanstack/react-query": "^5.90.21",
    "@trigger.dev/sdk": "4.5.11",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@use-gesture/react": "^10.3.1",
    "better-auth": "1.6.28",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "hugeicons-react": "^0.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.552.0",
    "modern-screenshot": "^4.6.6",
    "motion": "^12.23.24",
    "mp4-muxer": "^5.2.2",
    "next": "^16.3.0",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.56.1",
    "posthog-js": "^1.352.0",
    "prisma": "^6.19.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-moveable": "^0.56.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-tweet": "^3.3.0",
    "redis": "6.2.1",
    "resend": "^6.20.0",
    "server-only": "0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.3.1",
    "three": "^0.182.0",
    "webm-muxer": "^5.1.4",
    "zod": "^4.1.12",
    "zundo": "^2.3.0",
    "zustand": "^5.0.8"
  },
  "overrides": {
    "@better-auth/core": "1.6.28"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.7.0",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.36.0"
  }
}
