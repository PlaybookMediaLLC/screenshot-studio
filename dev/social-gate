#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

./dev/studio env

set -a
# shellcheck source=/dev/null
source .local/dev.env
set +a

# BSD mktemp only replaces trailing X's, so the template has no suffix.
BOOTSTRAP_FILE="$(mktemp "$ROOT_DIR/.local/social-gate.XXXXXX")"
chmod 600 "$BOOTSTRAP_FILE"

gate_compose() {
  docker compose --env-file .local/dev.env --file dev/compose.yaml --file dev/compose.social-gate.yaml \
    --project-name screenshot-studio-social-gate "$@"
}

wait_http() {
  local url=$1
  for _ in $(seq 1 120); do
    if curl --fail --silent --output /dev/null "$url"; then return 0; fi
    sleep 1
  done
  echo "Social gate service did not become ready: $url" >&2
  return 1
}

cleanup() {
  local original_status=$?
  trap - EXIT
  if [[ "$original_status" -ne 0 ]]; then
    echo 'Social gate service logs (last 100 lines per container):' >&2
    gate_compose logs --no-color --tail=100 2>&1 |
      sed -E 's#(https?://[^[:space:]"]+)\?[^[:space:]"]+#\1?[redacted]#g' >&2 || true
  fi
  gate_compose down --volumes --remove-orphans || original_status=1
  rm -f "$BOOTSTRAP_FILE"
  exit "$original_status"
}
trap cleanup EXIT

# The separate project has its own PostgreSQL, Redis, Temporal, and RustFS
# volumes. The product API connects the fake destinations in process, so the
# bootstrap needs only the running backend. The Go services share one image
# tag, so it is built once: parallel builds of one tag race to name it.
gate_compose build publishing-backend app
gate_compose up --detach \
  postgres redis rustfs rustfs-init temporal platform-go-migrate fake-social \
  publishing-backend publishing-orchestrator app
wait_http http://127.0.0.1:8180/readyz
wait_http http://127.0.0.1:8181/readyz
GATE_DATABASE_URL="postgresql://screenshot_studio:${POSTGRES_APP_PASSWORD}@127.0.0.1:54349/screenshot_studio?sslmode=disable"
E2E_DATABASE_URL="$GATE_DATABASE_URL" SOCIAL_GATE_API_URL=http://127.0.0.1:8180 \
  node clients/apps/web/test/e2e/fixtures/bootstrap-go.mjs "$BOOTSTRAP_FILE"
wait_http http://127.0.0.1:3010/api/health
E2E_BASE_URL=http://localhost:3010 \
E2E_DATABASE_URL="$GATE_DATABASE_URL" \
E2E_R2_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" \
E2E_R2_BUCKET_NAME="$R2_BUCKET_NAME" \
E2E_R2_ENDPOINT=http://127.0.0.1:9013 \
E2E_R2_REGION="$R2_REGION" \
E2E_R2_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY" \
E2E_REDIS_URL=redis://127.0.0.1:63809 \
E2E_SOCIAL_GATE_BOOTSTRAP="$BOOTSTRAP_FILE" \
  npm --prefix clients/apps/web run test:e2e -- test/e2e/social-gate.spec.ts --retries=0
