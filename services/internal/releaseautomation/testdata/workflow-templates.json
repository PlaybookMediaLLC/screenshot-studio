  "feature-announcement": {
    "schemaVersion": 1,
    "family": "pull_request.merged",
    "qualification": {
      "group": "ALL",
      "children": [
        {
          "field": "pr.base",
          "operator": "eq",
          "values": [
            "main"
          ]
        },
        {
          "field": "pr.bot",
          "operator": "is_false"
        }
      ]
    },
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger"
      },
      {
        "id": "condition",
        "type": "condition",
        "condition": {
          "group": "ANY",
          "children": [
            {
              "field": "pr.labels",
              "operator": "in",
              "values": [
                "feature",
                "marketing",
                "release"
              ]
            },
            {
              "field": "pr.title",
              "operator": "starts_with",
              "values": [
                "feat"
              ]
            }
          ]
        }
      },
      {
        "id": "release",
