{
  "release-launch": {
    "schemaVersion": 2,
    "family": "release.published",
    "qualification": {
      "field": "release.tag",
      "operator": "glob",
      "values": [
        "v*"
      ]
    },
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger"
      },
      {
        "id": "condition",
        "type": "condition",
        "condition": {
          "field": "release.prerelease",
          "operator": "is_false"
        }
      },
      {
        "id": "release",
        "type": "action",
        "action": {
          "type": "create_release"
        }
      },
      {
        "id": "campaign",
        "type": "action",
        "action": {
          "type": "create_campaign",
          "input": {
            "nodeId": "release",
            "output": "releaseId"
          },
          "brandKitId": "brand-fixture",
          "destinationIds": [
            "destination-fixture"
          ]
        }
      },
      {
        "id": "review",
        "type": "action",
        "action": {
          "type": "submit_review",
          "input": {
            "nodeId": "campaign",
            "output": "campaignId"
          }
        }
      },
      {
        "id": "done",
        "type": "end",
        "outcome": "completed"
      },
      {
        "id": "skip",
        "type": "end",
        "outcome": "skipped"
      }
    ],
    "edges": [
      {
        "from": "trigger",
        "to": "condition",
        "branch": "next"
      },
      {
        "from": "condition",
        "to": "release",
        "branch": "true"
      },
      {
        "from": "condition",
        "to": "skip",
        "branch": "false"
      },
      {
        "from": "release",
        "to": "campaign",
        "branch": "next"
      },
      {
        "from": "campaign",
        "to": "review",
        "branch": "next"
      },
      {
        "from": "review",
        "to": "done",
        "branch": "next"
      }
    ]
  },
  "release-launch+all": {
    "schemaVersion": 2,
    "family": "release.published",
    "qualification": {
      "group": "ALL",
      "children": [
        {
          "field": "release.tag",
          "operator": "glob",
          "values": [
            "v*"
          ]
        },
        {
          "field": "version.level",
          "operator": "in",
          "values": [
            "major",
            "minor"
          ]
        }
      ]
    },
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger"
      },
      {
        "id": "condition",
        "type": "classify",
        "classify": {
          "criteria": "Customer-visible features, improvements, or fixes a user would notice. Not refactors, dependency bumps, tests, or CI.",
          "threshold": 0.7,
          "creditLimit": 5
        }
      },
      {
        "id": "release",
        "type": "action",
        "action": {
          "type": "create_release"
        }
      },
      {
        "id": "campaign",
        "type": "action",
        "action": {
          "type": "create_campaign",
          "input": {
            "nodeId": "release",
            "output": "releaseId"
          },
          "brandKitId": "brand-fixture",
          "destinationIds": [
            "destination-fixture"
          ]
        }
      },
      {
        "id": "copy",
        "type": "action",
        "action": {
          "type": "generate_copy",
          "input": {
            "nodeId": "campaign",
            "output": "campaignId"
          },
          "creditLimit": 40
        }
      },
      {
        "id": "art",
        "type": "action",
        "action": {
          "type": "render_creatives",
          "input": {
            "nodeId": "copy",
            "output": "campaignId"
          },
          "templateIds": [
            "layout-browser-launch",
            "layout-phone-duo"
          ]
        }
      },
      {
        "id": "review",
        "type": "action",
        "action": {
          "type": "submit_review",
          "input": {
            "nodeId": "art",
            "output": "campaignId"
          }
        }
      },
      {
        "id": "done",
        "type": "end",
        "outcome": "completed"
      },
      {
        "id": "skip",
        "type": "end",
        "outcome": "skipped"
      }
    ],
    "edges": [
      {
        "from": "trigger",
        "to": "condition",
        "branch": "next"
      },
      {
        "from": "condition",
        "to": "release",
        "branch": "true"
      },
      {
        "from": "condition",
        "to": "skip",
        "branch": "false"
      },
      {
        "from": "release",
        "to": "campaign",
        "branch": "next"
      },
      {
        "from": "campaign",
        "to": "copy",
        "branch": "next"
      },
      {
        "from": "copy",
        "to": "art",
        "branch": "next"
      },
      {
        "from": "art",
        "to": "review",
        "branch": "next"
      },
      {
        "from": "review",
        "to": "done",
        "branch": "next"
      }
    ]
  },
