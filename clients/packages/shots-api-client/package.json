{
  "name": "shots-api-client",
  "version": "0.1.0",
  "description": "Typed client for the Shots REST API, generated from its OpenAPI document",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlaybookMediaLLC/screenshot-studio.git",
    "directory": "packages/shots-api-client"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  }
}
