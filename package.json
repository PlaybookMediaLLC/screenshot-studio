{
  "name": "screenshot-studio",
  "version": "2.36.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:sdk": "npm run build -w screenshot-studio-backend-sdk",
    "api:generate": "tsx scripts/openapi.ts && openapi-typescript services/internal/shotsapi/openapi.json -o packages/shots-api-client/src/schema.ts",
    "start": "next start",
    "db:migrate": "cd services && go run ./cmd/platform-migrate",
    "format": "prettier --write app/api lib/api lib/audit lib/email lib/tenant lib/auth lib/rate-limit.ts lib/redis.ts lib/screenshot-cache.ts lib/screenshot-service.ts lib/storage test .github/workflows commitlint.config.mjs playwright.config.ts packages/platejs-editor/test",
    "format:check": "prettier --check app/api lib/api lib/audit lib/email lib/tenant lib/auth lib/rate-limit.ts lib/redis.ts lib/screenshot-cache.ts lib/screenshot-service.ts lib/storage test .github/workflows commitlint.config.mjs playwright.config.ts packages/platejs-editor/test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "rm -rf .next/types && next typegen && tsc --noEmit",
    "quality:check": "npm run format:check && npm run lint -- --max-warnings=0 && npm run typecheck && npm run test && npm run verify:rfcs",
    "test": "tsx --test test/*.test.ts && npm test --workspaces --if-present",
    "test:publishing-backend-client": "NODE_OPTIONS='--conditions=react-server' tsx --test test/publishing-backend-client.server.ts",
    "test:design-renderer": "NODE_OPTIONS='--conditions=react-server' tsx --test test/design-renderer.server.ts",
    "test:workspace-creation-server": "NODE_OPTIONS='--conditions=react-server' tsx --test test/workspace-creation.server.ts",
    "test:screenshot-capture": "NODE_OPTIONS='--conditions=react-server' tsx --test test/screenshot-capture.server.ts",
    "test:agents": "tsx --test test/agent-readiness.test.ts",
    "verify:agents": "tsx test/verify-agent-endpoints.ts",
    "test:e2e": "playwright test",
    "test:e2e:onboarding": "playwright test test/e2e/onboarding.spec.ts",
    "test:e2e:recovery": "E2E_INCLUDE_RECOVERY=true playwright test test/e2e/dependency-recovery.spec.ts --workers=1",
    "test:tenant-isolation": "tsx scripts/verify-tenant-isolation.ts",
    "test:trpc-smoke": "tsx scripts/verify-trpc-smoke.ts",
    "commitlint": "commitlint",
    "prepare": "git config core.hooksPath .githooks || true",
    "upload-to-r2": "npm run upload-all-to-r2",
    "upload-all-to-r2": "python3 scripts/public-images.py --upload",
    "upload-pattern": "npm run upload-all-to-r2",
    "upload-demo": "npm run upload-all-to-r2",
    "verify:announcements": "tsx --tsconfig tsconfig.verify.json scripts/verify-announcement-authoring.ts",
    "verify:rfcs": "python3 scripts/verify-rfcs.py",
    "assets:manifest": "python3 scripts/public-images.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@better-auth/api-key": "1.6.28",
    "@better-auth/infra": "^0.3.7",
    "@better-auth/scim": "1.6.28",
    "@better-auth/sso": "1.6.28",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "~3.8.1",
    "@jsquash/avif": "^2.1.1",
    "@mediapipe/tasks-vision": "1.1.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@scalar/nextjs-api-reference": "^0.11.16",
    "@shadergradient/react": "^2.4.20",
    "@sparticuz/chromium": "^141.0.0",
    "@tanstack/react-query": "^5.90.21",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@use-gesture/react": "^10.3.1",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.127",
    "better-auth": "1.6.28",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "modern-screenshot": "^4.6.6",
    "motion": "^12.23.24",
    "mp4-muxer": "^5.2.2",
    "next": "^16.3.0",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "^1.56.1",
    "posthog-js": "^1.352.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-moveable": "^0.56.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-tweet": "^3.3.0",
    "redis": "6.2.1",
    "resend": "^6.20.0",
    "server-only": "0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^23.0.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "7.0.0",
    "three": "^0.182.0",
    "twitter-text": "3.1.0",
    "vaul": "^1.1.2",
    "webm-muxer": "^5.1.4",
    "zod": "^4.1.12",
    "zundo": "^2.3.0",
    "zustand": "^5.0.8"
  },
  "overrides": {
    "@better-auth/core": "1.6.28"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/twitter-text": "3.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.7.0",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.36.0"
  }
}
