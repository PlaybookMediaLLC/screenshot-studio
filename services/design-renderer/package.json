{
  "name": "playbook-design-renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test deploy",
    "test": "npm run build && tsx --test test/*.test.ts",
    "test:unit": "npm run build && tsx --test test/schemas.test.ts",
    "browsers:install": "playwright-core install chromium"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.46.1"
  }
}
